{
  "name": "Faq",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "description": "Question fr\u00e9quente"
    },
    "answer": {
      "type": "string",
      "description": "R\u00e9ponse affich\u00e9e au d\u00e9pliage"
    },
