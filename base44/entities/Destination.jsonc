{
  "name": "Destination",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du site ou de la destination"
    },
    "region": {
      "type": "string",
      "description": "R\u00e9gion ou ville de rattachement"
    },
    "text": {
      "type": "string",
      "description": "Courte description affich\u00e9e sur la carte"
    },
    "price": {
      "type": "string",
      "description": "Prix indicatif affich\u00e9, par exemple \u00ab d\u00e8s 390 \u20ac / personne \u00bb"
    },
    "image": {
      "type": "string",
      "description": "URL de la photo de la destination"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u00c9tiquettes courtes (Plage, Randonn\u00e9e, UNESCO\u2026)"
    },
    "order": {
      "type": "number",
      "description": "Ordre d'affichage sur le site"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}