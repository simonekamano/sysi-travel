{
  "name": "DemandeSejour",
  "type": "object",
  "properties": {
    "nom": {
      "type": "string",
      "description": "Nom complet du voyageur"
    },
    "email": {
      "type": "string",
      "description": "Email de contact"
    },
    "telephone": {
      "type": "string",
      "description": "Num\u00e9ro WhatsApp ou t\u00e9l\u00e9phone"
    },
    "pays": {
      "type": "string",
      "description": "Pays de r\u00e9sidence"
    },
    "destination": {
      "type": "string",
      "description": "Destination souhait\u00e9e"
    },
    "formule": {
      "type": "string",
      "description": "Formule de s\u00e9jour choisie"
    },
    "periode": {
      "type": "string",
      "description": "P\u00e9riode de d\u00e9part envisag\u00e9e"
    },
    "voyageurs": {
      "type": "string",
      "description": "Nombre de voyageurs"
    },
    "message": {
      "type": "string",
      "description": "Message libre du voyageur"
    },
    "statut": {
      "type": "string",
      "enum": [
        "nouveau",
        "en cours",
        "traite"
      ],
      "default": "nouveau",
      "description": "Suivi interne de la demande"
    }
  },
  "required": [
    "nom",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}