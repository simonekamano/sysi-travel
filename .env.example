# Copier en .env sur le VPS (à côté de docker-compose.yml) et remplir.
# Les valeurs viennent du fichier .env de Supabase self-hosted (supabase/docker/.env).

# --- Navigateur (compilées dans le bundle au build : uniquement des valeurs publiques) ---
# URL publique de l'API Supabase (Kong), derrière Nginx en HTTPS.
VITE_SUPABASE_URL=https://api.votre-domaine.com
# ANON_KEY de Supabase : publique par conception, la Row Level Security protège les données.
VITE_SUPABASE_ANON_KEY=
# "true" seulement si Google est configuré dans Supabase (GOTRUE_EXTERNAL_GOOGLE_*).
VITE_SUPABASE_GOOGLE_ENABLED=false

# --- Serveur (lues à l'exécution) ---
# Adresse de Supabase vue depuis le conteneur de l'app. Par défaut la même que ci-dessus ;
# sur le même VPS, l'adresse interne évite un aller-retour par Internet :
#   SUPABASE_URL=http://host.docker.internal:8000
SUPABASE_URL=
SUPABASE_ANON_KEY=

PORT=3000
