# Configuration de production : /opt/sysi-travel/.env sur le VPS (jamais dans Git).
# Les clés viennent de /opt/supabase/.env (Supabase auto-hébergé).

# --- Navigateur (compilées dans le bundle au build : uniquement des valeurs publiques) ---
# URL publique de l'API Supabase (Kong), derrière Nginx en HTTPS.
VITE_SUPABASE_URL=https://api.sysitravel.com
# ANON_KEY de Supabase : publique par conception, la Row Level Security protège les données.
VITE_SUPABASE_ANON_KEY=
# "true" seulement si Google est configuré dans Supabase (GOTRUE_EXTERNAL_GOOGLE_*).
VITE_SUPABASE_GOOGLE_ENABLED=false

# --- Serveur (lues à l'exécution) ---
# Supabase vu depuis le conteneur de l'app (réseau Docker supabase_default).
SUPABASE_URL=http://kong:8000
SUPABASE_ANON_KEY=
# Adresse publique du site, pour sitemap.xml et robots.txt.
SITE_URL=https://sysitravel.com
