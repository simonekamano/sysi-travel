# Configuration de production : /opt/sysi-travel/.env sur le VPS (jamais dans Git).
# Les clés viennent de /opt/supabase/.env (Supabase auto-hébergé).

# --- Navigateur (compilées dans le bundle au build : uniquement des valeurs publiques) ---
# URL publique de l'API Supabase (Kong), derrière Nginx en HTTPS.
VITE_SUPABASE_URL=https://api.sysitravel.com
# ANON_KEY de Supabase : publique par conception, la Row Level Security protège les données.
VITE_SUPABASE_ANON_KEY=
# "true" seulement si Google est configuré dans Supabase (GOTRUE_EXTERNAL_GOOGLE_*).
VITE_SUPABASE_GOOGLE_ENABLED=false

# --- Serveur (lues à l'exécution) ---
# Supabase vu depuis le conteneur de l'app (réseau Docker supabase_default).
SUPABASE_URL=http://kong:8000
SUPABASE_ANON_KEY=
# Adresse publique du site, pour sitemap.xml et robots.txt.
SITE_URL=https://sysitravel.com

# --- E-mails des demandes de séjour (Resend) ---
# Clé API Resend (la même que SMTP_PASS dans /opt/supabase/.env). Vide : aucun e-mail envoyé.
RESEND_API_KEY=
# Expéditeur, sur le domaine vérifié dans Resend.
MAIL_FROM=SYSI TRAVEL <no-reply@sysitravel.com>
# Qui reçoit chaque nouvelle demande. Vide : l'e-mail de contact du site (CONTACT.email, src/data/site.js).
MAIL_NOTIFY_TO=

# --- Paiement en ligne par carte (Stripe), DEPLOIEMENT.md § 4.5 ---
# Les trois vides : pas de paiement en ligne (les circuits restent en « Tarif sur demande »).
# Clé secrète Stripe (Developers › API keys) : sk_test_… pour les essais, sk_live_… en réel.
STRIPE_SECRET_KEY=
# Secret de signature du point de notification (Developers › Webhooks), whsec_….
# Adresse à déclarer : https://sysitravel.com/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=
# SERVICE_ROLE_KEY de /opt/supabase/.env : lue seulement par src/lib/paiement.js, côté serveur,
# pour enregistrer un paiement que Stripe a confirmé. Jamais dans une variable VITE_*.
SUPABASE_SERVICE_ROLE_KEY=
